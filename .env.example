NODE_ENV=development
PORT=3000
# Public origin users visit (dev with Vite proxy: http://localhost:5173)
APP_URL=http://localhost:5173
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a Redirect URI in the Discord Developer Portal
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback
# Use a least-privilege user, e.g. mongodb://app:PASS@host:27017/discord_sso?authSource=discord_sso
MONGODB_URI=mongodb://127.0.0.1:27017/discord_sso
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_HOURS=24
# Hops of trusted proxies in front of the app (0 = none, 1 = one load balancer)
TRUST_PROXY=0
# Optional: override the compiled client location (default: client/dist)
# CLIENT_DIST=
